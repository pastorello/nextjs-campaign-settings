# Database connection
POSTGRES_DB=campaign_settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# App authentication
# Generate with: pnpm dlx auth secret
AUTH_SECRET=your-generated-secret-key-here

# Constructed from POSTGRES_* vars above
DATABASE_URL="postgresql://admin:change_me@localhost:5432/campaign_settings"

# Where uploaded map images are stored on disk (ADR-0008). Must be an
# absolute path — a relative one resolves against process.cwd(), which
# differs between checkouts of this repo (e.g. an agent worktree vs. your
# own clone) even when they share the DATABASE_URL above (TD-66). Leave
# unset to use a fixed default under your home directory instead.
# UPLOAD_DIR="/absolute/path/to/campaign-settings/storage/maps"
