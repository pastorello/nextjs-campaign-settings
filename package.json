{
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "next build --turbopack",
    "dev": "next dev --turbopack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:import": "tsx --env-file-if-exists=.env app/seed/importLibrary.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.4",
    "@tiptap/core": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/kinks": "7.4.0",
    "autoprefixer": "10.6.2",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.9.1",
    "htmlparser2": "12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "polygon-clipping": "0.15.7",
    "polylabel": "2.1.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/polylabel": "2.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "10.6.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "storybook": "10.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vite": "8.1.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "eslint-plugin-react-hooks": "7.1.1"
    }
  }
}
