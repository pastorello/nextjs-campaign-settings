generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model deities {
  id              Int      @id @default(autoincrement())
  name            String   @map("nome")
  deityTitle      String   @map("titolopatrono")
  deityType       Int      @map("tipopatrono")
  deityRank       Int      @map("gradopatrono")
  tarotCard       Int      @map("card")
  celestialBody   Int      @map("astri")
  element         Int      @map("elemento")
  class           Int      @map("classe")
  holidays        String   @map("festivita") @db.VarChar(255)
  color           Int      @map("colore")
  tradition       Int      @map("tradizione")
  alignment       Int      @map("allineamento")
  alignmentDomain Int      @map("dominioallineamento")
  meaning         String   @map("significato")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // SPEC-008 — where this record is. Both null means unplaced, which is a
  // legitimate state the UI reports rather than an error ("Sconosciuta",
  // SPEC-007 T3). Written by the two-step assignment modal (T3/T4, shipped);
  // see ADR-0010 for why they are independent FKs rather than mutually
  // exclusive, and for the `zoneId := poi.zoneId` invariant that keeps them
  // in agreement.
  zoneId Int?
  zone   zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  poiId  Int?
  poi    poi?  @relation(fields: [poiId], references: [id], onDelete: Restrict)

  // SPEC-014 T2 — world history events that name this deity.
  calendarEvents calendarEvent[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([name])
}

model magicitems {
  id          Int      @id @default(autoincrement())
  description String   @map("descrizione")
  name        String   @map("nome")
  rarity      Int      @map("rarita")
  type        Int      @map("tipo")
  attuned     Boolean? @map("sintonia")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SPEC-013 T2 — a magic item that is consumed on use (scroll, potion) rather
  // than worn or wielded. Distinct from `type`: a wand with charges is
  // permanent and a wondrous item can be single-use, so this cannot be
  // derived from `type` alone. Backfilled from `type` as a starting point —
  // see the migration SQL — then corrected by hand where the derivation
  // guessed wrong.
  consumable Boolean @default(false)

  loot loot[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([name])
}

model npc {
  id              Int      @id @default(autoincrement())
  description     String?  @map("descrizione")
  name            String   @map("nome")
  title           String?  @map("titolo") @db.VarChar(255)
  alignment       Int      @map("allineamento")
  alignmentDomain Int      @map("dominioallineamento")
  position        String?  @map("mansione") @db.VarChar(255)
  faction         Int?     @map("fazione")
  appearance      String?  @map("aspetto")
  personality     String?  @map("personalita")
  motivations     String?  @map("motivazioni")
  secrets         String?  @map("segreti")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // SPEC-008 — where this record is. Both null means unplaced, which is a
  // legitimate state the UI reports rather than an error ("Sconosciuta",
  // SPEC-007 T3). Written by the two-step assignment modal (T3/T4, shipped);
  // see ADR-0010 for why they are independent FKs rather than mutually
  // exclusive, and for the `zoneId := poi.zoneId` invariant that keeps them
  // in agreement.
  zoneId Int?
  zone   zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  poiId  Int?
  poi    poi?  @relation(fields: [poiId], references: [id], onDelete: Restrict)

  // SPEC-006 — `factionRef` adds the FK's integrity guarantee, named to
  // avoid colliding with the sibling scalar field `faction` on this same
  // model, not because the `faction` table needs a different name.
  factionRef faction? @relation(fields: [faction], references: [id], onDelete: Restrict)

  // SPEC-013 T2 — back-relation required by sceneCreature.npc.
  sceneCreatures sceneCreature[]

  // SPEC-014 T2 — world history events that name this NPC.
  calendarEvents calendarEvent[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([name])
}

model faction {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @map("descrizione")

  npc npc[]

  // SPEC-014 T2 — world history events that name this faction.
  calendarEvents calendarEvent[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
}

// The containment tree (§6/ADR-0010) — `region`/`plane`/`city`/`dungeon`,
// each carrying its own map. Populated from the old `poi` table's
// navigable-kind rows by SPEC-008 T2's backfill, id-preserving; T8 finished
// the split by reshaping `poi` itself into the landmark-only leaf below.
model zone {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  kind           String
  parentId       Int?
  parent         zone?    @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       zone[]   @relation("ZoneTree")
  lat            Float?
  lng            Float?
  mapImage       String?
  mapBounds      Json?
  mapInitialView Json?
  mapInitialZoom Int?
  // The rectangle this place casts on its PARENT's map (SPEC-009). Not
  // `areaBounds`: `mapBounds` above already means something different, the
  // extent of this place's OWN map image. A place with a footprint is an
  // area; a place without one is a point. `lat`/`lng` still hold the
  // rectangle's derived centre so every existing consumer keeps working.
  footprint      Json?
  // SPEC-015 — the map's grid: squares across the image's width (the height
  // in squares is derived from the aspect ratio, never stored) and which of
  // the four named scales one square represents (`GridScale`). Both null is
  // the no-grid state every existing map starts in.
  gridColumns    Int?
  gridScale      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  npc            npc[]
  deities        deities[]
  poi            poi[]
  // SPEC-013 T2 — back-relation required by scene.zone.
  scenes         scene[]
  // SPEC-014 T2 — world history events that name this place.
  calendarEvents calendarEvent[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([parentId])
}

// SPEC-008 T8 — reshaped from SPEC-004's single polymorphic table into a
// landmark-only leaf: a `poi` row can no longer have children even by
// accident, because the schema no longer gives it a `parentId` to have them
// with (ADR-0010). Every remaining row is what used to be `kind: "poi"` —
// the navigable kinds (`region`/`plane`/`city`/`dungeon`) live in `zone`
// now, and entity pins (`kind: "deity"`/`"npc"`) are gone, superseded by
// `npc.zoneId`/`poiId` and `deities.zoneId`/`poiId`. The live dev database
// had zero landmark rows at migration time, so this reshape needed no data
// migration beyond deleting the superseded rows (see the migration SQL).
model poi {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  lat         Float?
  lng         Float?
  category    String
  zoneId      Int
  zone        zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  npc     npc[]
  deities deities[]

  @@index([zoneId])
}

model spells {
  id            Int      @id @default(autoincrement())
  description   String   @map("descrizione")
  name          String   @map("nome")
  level         Int      @map("livello")
  circle        Int[]    @map("circolo")
  classes       Int[]    @map("classi")
  castingTime   String   @map("tempodilancio")
  range         String   @map("gittata")
  components    String   @map("componenti")
  duration      String   @map("durata")
  savingThrow   String?  @map("tirosalvezza") @db.VarChar(255)
  ritual        Boolean? @map("rituale")
  upcast        String?  @map("intensificato")
  concentration Boolean? @map("concentrazione")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
}

model users {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SPEC-013 T2 — campaign management. Six tables: a campaign groups
// adventures; an adventure is a sequence of scenes; a scene may fight
// creatures and give up loot. New tables use English column names, no
// `@map` — the Italian columns elsewhere are legacy decoupled by `@map`,
// not a convention to extend (CLAUDE.md, Language conventions).
model campaign {
  id         Int      @id @default(autoincrement())
  title      String
  synopsis   String?
  partySize  Int      @default(4)
  // SPEC-018 T3 / ADR-0013 rule 9: the game system's URL slug, a closed
  // vocabulary in code (`GAME_SYSTEMS`), like `adventure.status`. The
  // default backfills every campaign that existed before systems did.
  system     String   @default("dnd5e")
  // SPEC-014 T2 — the campaign's "today", a universal day number (§5.5).
  // Null = no today set, so nothing reads as past.
  currentDay Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  adventures     adventure[]
  calendarEvents calendarEvent[]
}

model adventure {
  id         Int       @id @default(autoincrement())
  campaignId Int?
  campaign   campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  position    Int
  targetLevel Int
  title       String
  synopsis    String?
  status      String // planned | active | completed — closed vocabulary in code

  xpTarget            Int?
  currencyTarget      Int? // stored in silver, like every value in this spec
  currencyUnit        String? // silver | gold — DISPLAY only, see the counting rule
  permanentItemTarget Int?
  consumableTarget    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenes         scene[]
  calendarEvents calendarEvent[]

  @@index([campaignId])
}

model scene {
  id          Int       @id @default(autoincrement())
  adventureId Int
  adventure   adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  position        Int
  kind            String // fight | explore | clue | goal | dungeon | break
  title           String
  description     String?
  xpAward         Int?
  grantsHeroPoint Boolean @default(false)
  awarded         Boolean @default(false)

  zoneId Int?
  zone   zone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Corrected from §6's draft, which named this `treasures treasure[]`: a
  // scene's rows are `loot`, which is what carries `sceneId`; `treasure` is
  // the catalogue and has no back-relation to `scene` (see the PR body).
  creatures      sceneCreature[]
  loot           loot[]
  calendarEvents calendarEvent[]

  @@index([adventureId])
  @@index([zoneId])
}

model sceneCreature {
  id      Int   @id @default(autoincrement())
  sceneId Int
  scene   scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  position Int
  name     String
  level    Int?
  xpEach   Int?
  quantity Int     @default(1)
  note     String?
  awarded  Boolean @default(false)

  npcId Int?
  npc   npc? @relation(fields: [npcId], references: [id], onDelete: SetNull)

  @@index([sceneId])
}

// What a scene gives up. Named `loot`, not `treasure`: `treasure` is now the
// catalogue below, the page the DM browses. A scene has loot; loot points at
// the catalogue.
model loot {
  id      Int   @id @default(autoincrement())
  sceneId Int
  scene   scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  position    Int
  description String
  quantity    Int     @default(1)
  value       Int? // in silver; supplies or overrides the catalogue's value
  taken       Boolean @default(false)

  // At most one link, enforced by the validator, never both.
  magicItemId Int?
  magicitem   magicitems? @relation(fields: [magicItemId], references: [id], onDelete: SetNull)
  treasureId  Int?
  treasure    treasure?   @relation(fields: [treasureId], references: [id], onDelete: SetNull)

  @@index([sceneId])
}

// The seventh domain: non-magical valuables. Same shape as `magicitems` — a
// library the DM authors once and draws on from any adventure. Coins, art
// objects, gems, trade goods.
model treasure {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    Int // static options, like magicitems.type
  value       Int? // in silver
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loot loot[]

  // SPEC-020 T2 — this record's one image (ADR-0017). Unique: one image per
  // record, and an image belongs to one record. SetNull: deleting the image
  // row clears the reference; the actions delete the row and its two files
  // when the record is deleted or its image replaced or removed (T3).
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([name])
}

// SPEC-014 T2 — the calendar. Every date is a universal day number: day 0 is
// the first day of year 0 of the universal count (§5.1). English column
// names, no `@map`, as on the SPEC-013 tables.
//
// The migration adds guards the schema language cannot express. They are raw
// SQL, so `prisma migrate diff` does not know them: check that a later
// generated migration does not drop them.
// - `dateSystem_one_universal` / `dateSystem_one_default`: partial unique
//   indexes, at most one row with `isUniversal = true` and at most one with
//   `isDefault = true`. The actions keep it "exactly one" (switching the
//   default clears the old row before setting the new, in one transaction);
//   the index turns a bug there into an error instead of two defaults that
//   every date display would then have to choose between.
// - CHECKs: exactly 12 month names and 7 weekday names (§5.2).
// It also inserts the universal count, as the default, with Italian
// placeholder names the DM edits (§6).
model dateSystem {
  id           Int      @id @default(autoincrement())
  isUniversal  Boolean  @default(false) // exactly one row, created by the migration
  isDefault    Boolean  @default(false) // exactly one row; enforced in the actions
  name         String
  anchorEvent  String? // null for the universal count
  anchorYear   Int      @default(0) // universal year of the anchor; 0 for the universal count
  afterLabel   String // "Dopo Cataclisma"
  afterAbbrev  String // "d.C."
  beforeLabel  String? // null for the universal count, which has no "before"
  beforeAbbrev String?
  monthNames   String[] // exactly 12 (CHECK in the migration)
  weekdayNames String[] // exactly 7 (CHECK in the migration)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A singleton: the migration inserts row 1 and nothing creates another.
model calendarSettings {
  id             Int  @id @default(1)
  moonNewMoonDay Int? // a universal day; null = no moon phases shown (§5.3)
}

// Campaign events (`campaignId` set; may name an adventure and a scene) and
// world history events (`campaignId` null; may link places, NPCs, deities and
// factions) share one table (§5.4). Which kind may carry which links, and
// that the scene belongs to the adventure, are the validator's rules, not the
// schema's. CHECKs in the migration: `startDay >= 0` (nothing precedes the
// dawn of time), `endDay >= startDay`, hours in 0–23.
model calendarEvent {
  id            Int     @id @default(autoincrement())
  title         String
  description   String?
  startDay      Int // universal day
  startHour     Int? // 0–23
  endDay        Int? // universal day; null = a one-day event
  endHour       Int? // 0–23
  repeatsYearly Boolean @default(false)

  campaignId  Int? // null = world history
  campaign    campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adventureId Int?
  adventure   adventure? @relation(fields: [adventureId], references: [id], onDelete: SetNull)
  sceneId     Int?
  scene       scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  // World history only. Implicit many-to-many: deleting a place, NPC, deity
  // or faction removes its join rows and leaves the event (§5, edge cases).
  zones    zone[]
  npcs     npc[]
  deities  deities[]
  factions faction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, startDay])
  @@index([startDay])
  // Not in §6's draft: the FK columns a SetNull scans on an adventure or
  // scene delete, indexed like the other FKs here (`scene.zoneId`, ...).
  @@index([adventureId])
  @@index([sceneId])
}

// SPEC-020 T2 — one image of one record (ADR-0017): the storage keys of its
// two WebP versions in the record image store (`UPLOAD_DIR/records`) and the
// display version's size. Owned through a nullable unique `imageId` on each
// owning table rather than a polymorphic owner here, so every reference is a
// real foreign key. SPEC-021's Daggerheart domain (`dhDomain`, below) is the
// seventh owner.
model recordImage {
  id         Int      @id @default(autoincrement())
  displayKey String
  thumbKey   String
  mimeType   String
  width      Int
  height     Int
  createdAt  DateTime @default(now())

  npc       npc?
  deity     deities?
  magicItem magicitems?
  treasure  treasure?
  faction   faction?
  zone      zone?
  dhDomain  dhDomain?
}

// SPEC-021 T1 — the Daggerheart catalogue: domains, domain cards, classes and
// subclasses. One table per system and domain (SPEC-018 §6); the `dh` prefix
// keeps the unprefixed 5e tables meaning 5e (ADR-0013 rule 7, as amended by
// SPEC-021 §6). English column names, no `@map`, as on the SPEC-013 tables.
// Nothing is seeded: the public repo holds rules structure, never rules
// content (SPEC-018 §5).
//
// String vocabularies are closed in code, like `scene.kind`: `origin`, a
// card's `type`, a subclass feature's `tier` and a subclass's
// `spellcastTrait` (app/lib/definitions/enums/daggerheart/), and a domain's
// `colour`, a palette key rather than free hex (SPEC-021 T2).
//
// The migration adds CHECKs the schema language cannot express. They are raw
// SQL, so `prisma migrate diff` does not know them: check that a later
// generated migration does not drop them.
// - `dhDomainCard_level_range`: level 1–10.
// - `dhDomainCard_recallCost_nonnegative`: recall cost ≥ 0.
// - `dhClass_distinct_domains`: a class's two domains differ.
//
// Features are one table per owner, not one polymorphic feature table
// (ADR-0018). They are ordered rows edited inline in their parent's page
// (ADR-0011), so they carry `position` and, like `sceneCreature`, no
// timestamps.
model dhDomain {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  colour      String
  origin      String   @default("homebrew")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SPEC-020 / ADR-0017 — the domain's emblem, as on every image owner.
  imageId Int?         @unique
  image   recordImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  cards      dhDomainCard[]
  classesAsA dhClass[]      @relation("dhClassDomainA")
  classesAsB dhClass[]      @relation("dhClassDomainB")

  @@index([name])
}

model dhDomainCard {
  id          Int      @id @default(autoincrement())
  name        String
  domainId    Int
  domain      dhDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  // `cardLevel`/`cardType` in code, `level`/`type` in the table: the
  // metadata layer's field keys are one flat namespace, where `level` (spells)
  // and `type` (magic items) are taken (SPEC-021 T3).
  cardLevel   Int      @map("level")
  recallCost  Int
  cardType    String   @map("type")
  featureText String
  origin      String   @default("homebrew")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domainId, cardLevel])
  @@index([name])
}

model dhClass {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  domainAId       Int
  domainA         dhDomain @relation("dhClassDomainA", fields: [domainAId], references: [id], onDelete: Restrict)
  domainBId       Int
  domainB         dhDomain @relation("dhClassDomainB", fields: [domainBId], references: [id], onDelete: Restrict)
  startingEvasion Int
  startingHp      Int
  classItems      String?
  // The Hope feature always costs 3 Hope, so the cost is not stored.
  hopeFeatureName String
  hopeFeatureText String
  origin          String   @default("homebrew")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  features   dhClassFeature[]
  subclasses dhSubclass[]

  @@index([domainAId])
  @@index([domainBId])
  @@index([name])
}

model dhClassFeature {
  id       Int     @id @default(autoincrement())
  classId  Int
  class    dhClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  position Int
  name     String
  text     String

  @@index([classId])
}

model dhSubclass {
  id             Int      @id @default(autoincrement())
  classId        Int
  class          dhClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  spellcastTrait String?
  origin         String   @default("homebrew")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  features dhSubclassFeature[]

  @@index([classId])
  @@index([name])
}

// Ordered within its tier: `position` counts inside (subclassId, tier).
model dhSubclassFeature {
  id         Int        @id @default(autoincrement())
  subclassId Int
  subclass   dhSubclass @relation(fields: [subclassId], references: [id], onDelete: Cascade)
  tier       String
  position   Int
  name       String
  text       String

  @@index([subclassId])
}
