generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model deities {
  id                Int      @id @default(autoincrement())
  name              String   @map("nome")
  deityTitle        String   @map("titolopatrono")
  deityType         Int      @map("tipopatrono")
  deityRank         Int      @map("gradopatrono")
  tarotCard         Int      @map("card")
  celestialBody     Int      @map("astri")
  element           Int      @map("elemento")
  class             Int      @map("classe")
  holidays          String   @db.VarChar(255) @map("festivita")
  color             Int      @map("colore")
  tradition         Int      @map("tradizione")
  alignment         Int      @map("allineamento")
  alignmentDomain   Int      @map("dominioallineamento")
  meaning           String   @map("significato")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // SPEC-008 — where this record is. Both null means unplaced, which is a
  // legitimate state the UI reports rather than an error ("Sconosciuta",
  // SPEC-007 T3). Written by the two-step assignment modal (T3/T4, shipped);
  // see ADR-0010 for why they are independent FKs rather than mutually
  // exclusive, and for the `zoneId := poi.zoneId` invariant that keeps them
  // in agreement.
  zoneId Int?
  zone   zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  poiId  Int?
  poi    poi?  @relation(fields: [poiId], references: [id], onDelete: Restrict)

  @@index([name])
}

model magicitems {
  id          Int      @id @default(autoincrement())
  description String   @map("descrizione")
  name        String   @map("nome")
  rarity      Int      @map("rarita")
  type        Int      @map("tipo")
  attuned     Boolean? @map("sintonia")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model npc {
  id              Int      @id @default(autoincrement())
  description     String?  @map("descrizione")
  name            String   @map("nome")
  title           String?  @db.VarChar(255) @map("titolo")
  alignment       Int      @map("allineamento")
  alignmentDomain Int      @map("dominioallineamento")
  position        String?  @db.VarChar(255) @map("mansione")
  faction         Int?     @map("fazione")
  appearance      String?  @map("aspetto")
  personality     String?  @map("personalita")
  motivations     String?  @map("motivazioni")
  secrets         String?  @map("segreti")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // SPEC-008 — where this record is. Both null means unplaced, which is a
  // legitimate state the UI reports rather than an error ("Sconosciuta",
  // SPEC-007 T3). Written by the two-step assignment modal (T3/T4, shipped);
  // see ADR-0010 for why they are independent FKs rather than mutually
  // exclusive, and for the `zoneId := poi.zoneId` invariant that keeps them
  // in agreement.
  zoneId Int?
  zone   zone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  poiId  Int?
  poi    poi?  @relation(fields: [poiId], references: [id], onDelete: Restrict)

  // SPEC-006 — `factionRef` adds the FK's integrity guarantee, named to
  // avoid colliding with the sibling scalar field `faction` on this same
  // model, not because the `faction` table needs a different name.
  factionRef faction? @relation(fields: [faction], references: [id], onDelete: Restrict)

  @@index([name])
}

model faction {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @map("descrizione")

  npc npc[]
}

// The containment tree (§6/ADR-0010) — `region`/`plane`/`city`/`dungeon`,
// each carrying its own map. Populated from the old `poi` table's
// navigable-kind rows by SPEC-008 T2's backfill, id-preserving; T8 finished
// the split by reshaping `poi` itself into the landmark-only leaf below.
model zone {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  kind           String
  parentId       Int?
  parent         zone?    @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       zone[]   @relation("ZoneTree")
  lat            Float?
  lng            Float?
  mapImage       String?
  mapBounds      Json?
  mapInitialView Json?
  mapInitialZoom Int?
  // The rectangle this place casts on its PARENT's map (SPEC-009). Not
  // `areaBounds`: `mapBounds` above already means something different, the
  // extent of this place's OWN map image. A place with a footprint is an
  // area; a place without one is a point. `lat`/`lng` still hold the
  // rectangle's derived centre so every existing consumer keeps working.
  footprint      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  npc     npc[]
  deities deities[]
  poi     poi[]

  @@index([parentId])
}

// SPEC-008 T8 — reshaped from SPEC-004's single polymorphic table into a
// landmark-only leaf: a `poi` row can no longer have children even by
// accident, because the schema no longer gives it a `parentId` to have them
// with (ADR-0010). Every remaining row is what used to be `kind: "poi"` —
// the navigable kinds (`region`/`plane`/`city`/`dungeon`) live in `zone`
// now, and entity pins (`kind: "deity"`/`"npc"`) are gone, superseded by
// `npc.zoneId`/`poiId` and `deities.zoneId`/`poiId`. The live dev database
// had zero landmark rows at migration time, so this reshape needed no data
// migration beyond deleting the superseded rows (see the migration SQL).
model poi {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  lat         Float?
  lng         Float?
  category    String
  zoneId      Int
  zone        zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  npc     npc[]
  deities deities[]

  @@index([zoneId])
}

model spells {
  id              Int      @id @default(autoincrement())
  description     String   @map("descrizione")
  name            String   @map("nome")
  level           Int      @map("livello")
  circle          Int[]    @map("circolo")
  classes         Int[]    @map("classi")
  castingTime     String   @map("tempodilancio")
  range           String   @map("gittata")
  components      String   @map("componenti")
  duration        String   @map("durata")
  savingThrow     String?  @db.VarChar(255) @map("tirosalvezza")
  ritual           Boolean? @map("rituale")
  upcast          String?  @map("intensificato")
  concentration   Boolean? @map("concentrazione")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
}

model users {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
