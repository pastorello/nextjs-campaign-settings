generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model deities {
  id                Int      @id @default(autoincrement())
  name              String   @map("nome")
  deityTitle        String   @map("titolopatrono")
  deityType         Int      @map("tipopatrono")
  deityRank         Int      @map("gradopatrono")
  tarotCard         Int      @map("card")
  celestialBody     Int      @map("astri")
  element           Int      @map("elemento")
  class             Int      @map("classe")
  holidays          String   @db.VarChar(255) @map("festivita")
  color             Int      @map("colore")
  tradition         Int      @map("tradizione")
  alignment         Int      @map("allineamento")
  alignmentDomain   Int      @map("dominioallineamento")
  residence         Int      @map("residenza")
  location          Int      @map("luogo")
  meaning           String   @map("significato")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
}

model magicitems {
  id          Int      @id @default(autoincrement())
  description String   @map("descrizione")
  name        String   @map("nome")
  rarity      Int      @map("rarita")
  type        Int      @map("tipo")
  attuned     Boolean? @map("sintonia")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model npc {
  id              Int      @id @default(autoincrement())
  description     String?  @map("descrizione")
  name            String   @map("nome")
  title           String?  @db.VarChar(255) @map("titolo")
  alignment       Int      @map("allineamento")
  alignmentDomain Int      @map("dominioallineamento")
  position        String?  @db.VarChar(255) @map("mansione")
  location        Int      @map("luogo")
  faction         Int      @map("fazione")
  appearance      String?  @map("aspetto")
  personality     String?  @map("personalita")
  motivations     String?  @map("motivazioni")
  secrets         String?  @map("segreti")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
}

model poi {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  // Nullable since SPEC-004 M4: the tree's root `region` has no parent map
  // to be positioned on and no `category` (that's `kind: "poi"`'s field).
  // Every row `fetchPois` (SPEC-002's legacy read) serves is still fully
  // positioned and categorized — it filters out anything that is not.
  lat         Float?
  lng         Float?
  category    String?
  linkedType  String?
  linkedId    Int?

  // SPEC-004 M2 — additive, unused until M3+ validates and M4-M7 wire it up.
  // Existing rows default to `kind: "poi"`, `parentId: null`, keeping their
  // `category` as the only classification that currently means anything.
  kind        String   @default("poi")
  parentId    Int?
  parent      poi?     @relation("PoiTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    poi[]    @relation("PoiTree")

  // A place's own map (only meaningful for `kind: "region"`). Null for
  // every other kind, including all rows that predate M2.
  mapImage       String?
  mapBounds      Json?
  mapInitialView Json?
  mapInitialZoom Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([linkedType, linkedId])
  @@index([parentId])
}

model spells {
  id              Int      @id @default(autoincrement())
  description     String   @map("descrizione")
  name            String   @map("nome")
  level           Int      @map("livello")
  circle          Int[]    @map("circolo")
  classes         Int[]    @map("classi")
  castingTime     String   @map("tempodilancio")
  range           String   @map("gittata")
  components      String   @map("componenti")
  duration        String   @map("durata")
  savingThrow     String?  @db.VarChar(255) @map("tirosalvezza")
  ritual           Boolean? @map("rituale")
  upcast          String?  @map("intensificato")
  concentration   Boolean? @map("concentrazione")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
}

model users {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
